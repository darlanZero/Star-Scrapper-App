# Public mobile-client configuration. Copy this file to .env.
AnilistClientName=StarsLibrary
AnilistClientId=
AnilistOAuthUrl=https://anilist.co/api/v2/oauth/authorize
AnilistRedirectUrl=starslibrary://oauth/anilist

# Do not place AnilistClientSecret in a Flutter build. Mobile OAuth uses the
# implicit grant and cannot keep a client secret confidential.
